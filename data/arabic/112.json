{
  "surah": 112,
  "ayahs": {
    "1": {
      "uthmani": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
      "simple": "قل هو الله أحد"
    },
    "2": {
      "uthmani": "ٱللَّهُ ٱلصَّمَدُ",
      "simple": "الله الصمد"
    },
    "3": {
      "uthmani": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "simple": "لم يلد ولم يولد"
    },
    "4": {
      "uthmani": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
      "simple": "ولم يكن له كفوا أحد"
    }
  }
}