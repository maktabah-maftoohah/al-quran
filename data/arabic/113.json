{
  "surah": 113,
  "ayahs": {
    "1": {
      "uthmani": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "simple": "قل أعوذ برب الفلق"
    },
    "2": {
      "uthmani": "مِن شَرِّ مَا خَلَقَ",
      "simple": "من شر ما خلق"
    },
    "3": {
      "uthmani": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "simple": "ومن شر غاسق إذا وقب"
    },
    "4": {
      "uthmani": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
      "simple": "ومن شر النفاثات في العقد"
    },
    "5": {
      "uthmani": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "simple": "ومن شر حاسد إذا حسد"
    }
  }
}